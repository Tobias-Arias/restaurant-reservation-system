# ============================================================================
#  Variables de entorno del BACKEND
#
#  Copiá este archivo a `.env` y completá los valores.
#  El archivo `.env` NUNCA se sube al repositorio (está en .gitignore).
#
#  En dónde encontrar cada valor:
#    Supabase Dashboard > tu proyecto > Settings > API
#  ============================================================================

# ---------------------------------------------------------------------------
#  1. OBLIGATORIAS
# ---------------------------------------------------------------------------

# Project URL  ->  Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave pública (anon). Se usa para las operaciones de autenticación.
# Settings > API > Project > anon / public  (eyJ...)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key. SOLO en el backend: salta RLS y permite escribir en
# cualquier tabla. Settings > API > Project > service_role  (eyJ...)
# NUNCA copies esta clave al frontend ni la publiques en ningún repositorio.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
#  2. SERVIDOR
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Orígenes del frontend permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------------------------------------------------------------------------
#  3. DATOS DEL RESTAURANTE (opcionales: tienen valores por defecto)
# ---------------------------------------------------------------------------

RESTAURANTE_NOMBRE=Restaurante La Reserva
RESTAURANTE_DIRECCION=Av. Corrientes 1234, Buenos Aires
RESTAURANTE_TELEFONO=+54 11 5555 0000
RESTAURANTE_EMAIL=reservas@larestaurante.com

# ---------------------------------------------------------------------------
#  4. REGLAS DE NEGOCIO (opcionales)
#     Los horarios y turnos se editan en `config/horarios.js`.
#     La duración DEBE coincidir con fn_duracion_reserva() en schema.sql.
# ---------------------------------------------------------------------------

# Duración de cada reserva en minutos (90 por defecto).
RESERVA_DURACION_MIN=90

# Días máximos de anticipación para reservar.
RESERVA_ANTICIPACION_MAX_DIAS=90

# Máximo de reservas activas admitidas en la misma fecha y hora de inicio.
LIMITE_RESERVAS_POR_FRANJA=40

# Protección de fuerza bruta en /api/auth/login y /api/auth/register.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_VENTANA_MIN=15
