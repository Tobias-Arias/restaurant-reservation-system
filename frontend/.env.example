# ============================================================================
#  Variables de entorno del FRONTEND
#
#  Copiá este archivo a `.env` (o `.env.local`) y ajustá la URL del backend.
#
#  ⚠️  IMPORTANTE
#  En el frontend SOLO se permite VITE_API_URL. Jamás debe aparecer aquí
#  SUPABASE_ANON_KEY ni SUPABASE_SERVICE_ROLE_KEY: el navegador es público y
#  cualquier valor con prefijo VITE_ se compila dentro del bundle.
#
#  El frontend NO accede a Supabase: toda la comunicación pasa por la API
#  REST del backend. Ver README.md > Seguridad.
# ============================================================================

# URL base del backend Express (sin barra final).
VITE_API_URL=http://localhost:3000
