{
  "name": "restaurant-reservation-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión de reservas de restaurante · React + Node.js/Express + Supabase",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n BACKEND,FRONTEND -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "check": "npm run check --workspace backend && npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
